{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

https://localhost:{$ROOT_LOCAL_PORT} {
	bind 127.0.0.1
	tls "{$ROOT_LOCAL_CERT}" "{$ROOT_LOCAL_CERT_KEY}"

	@wrong_host not vars {http.request.hostport} localhost:{$ROOT_LOCAL_PORT}
	respond @wrong_host 421

	reverse_proxy [::1]:{$ROOT_LOCAL_SITE_PORT} {
		header_up Host [::1]:{$ROOT_LOCAL_SITE_PORT}
		header_up -Cookie
	}
}

https://127.0.0.1:{$ROOT_LOCAL_PORT} {
	bind 127.0.0.1
	tls "{$ROOT_LOCAL_CERT}" "{$ROOT_LOCAL_CERT_KEY}"

	@wrong_host not vars {http.request.hostport} 127.0.0.1:{$ROOT_LOCAL_PORT}
	@bad_write {
		method POST
		not vars {http.request.header.Origin} https://127.0.0.1:{$ROOT_LOCAL_PORT}
	}
	@missing_length {
		method POST
		not header Content-Length *
	}
	@oversized expression `{method} == 'POST' && {http.request.header.Content-Length} != '' && int({http.request.header.Content-Length}) > (path('/api/table/inspect') ? {$ROOT_LOCAL_INSPECT_LIMIT:6356992} : (path('/api/table/generate', '/api/tools/*', '/api/staged/*/publish') ? 16777216 : 16000))`
	@table_inspect path /api/table/inspect
	@tool_write path /api/table/generate /api/tools/* /api/staged/*/publish
	@standard {
		not path /api/table/inspect /api/table/generate /api/tools/* /api/staged/*/publish
	}

	route {
		respond @wrong_host 421
		respond @bad_write 403
		respond @missing_length 411
		header @oversized Content-Type application/json
		respond @oversized `{"code":"payload_too_large","message":"请求内容超过本机工作台大小限制。"}` 413
		request_body @tool_write {
			max_size 16777216
		}
		request_body @table_inspect {
			max_size {$ROOT_LOCAL_INSPECT_LIMIT:6356992}
		}
		request_body @standard {
			max_size 16000
		}
		reverse_proxy 127.0.0.1:{$ROOT_LOCAL_WORKBENCH_PORT} {
			header_up Host 127.0.0.1:{$ROOT_LOCAL_WORKBENCH_PORT}
			header_up Origin http://127.0.0.1:{$ROOT_LOCAL_WORKBENCH_PORT}
			header_down Set-Cookie "^root_session=.*$" "$0; Secure"
			header_down Connection-Allowlist "http://127[.]0[.]0[.]1:{$ROOT_LOCAL_WORKBENCH_PORT}/" "https://127.0.0.1:{$ROOT_LOCAL_PORT}/"
			transport http {
				dial_timeout 3s
				response_header_timeout 135s
			}
		}
	}
}
