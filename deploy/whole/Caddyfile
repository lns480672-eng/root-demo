workbench.example.invalid {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_http_challenge
		}
	}
	@wrong_host not vars {http.request.hostport} workbench.example.invalid
	@cutover_pending {
		not remote_ip 127.0.0.1 ::1
		file {
			root /run
			try_files /root-demo-whole.cutover
		}
	}
	@bad_write {
		method POST
		not vars {http.request.header.Origin} https://workbench.example.invalid
	}
	@missing_length {
		method POST
		not header Content-Length *
	}
	@oversized expression `{method} == 'POST' && {http.request.header.Content-Length} != '' && int({http.request.header.Content-Length}) > (path('/api/table/inspect') ? 6356992 : (path('/api/table/generate', '/api/tools/*', '/api/staged/*/publish', '/api/staged/*/verify-preview') ? 16777216 : 16000))`
	@table_inspect path /api/table/inspect
	@table_write path /api/table/generate /api/tools/* /api/staged/*/publish /api/staged/*/verify-preview
	@standard not path /api/table/inspect /api/table/generate /api/tools/* /api/staged/*/publish /api/staged/*/verify-preview
	@auth {
		method POST
		path /api/login /api/register /api/admin/login /api/admin/setup /api/admin/password
	}
	route {
		respond @wrong_host 421
		respond @cutover_pending 503
		respond @bad_write 403
		respond @missing_length 411
		header @oversized Content-Type application/json
		respond @oversized `{"code":"payload_too_large","message":"请求内容超过工作台大小限制。"}` 413
		forward_auth @auth 127.0.0.1:8775 {
			uri /check
			header_up X-Root-Remote {remote_host}
			header_up -Cookie
			header_up -Authorization
			transport http {
				dial_timeout 1s
				response_header_timeout 2s
			}
		}
		request_body @table_write {
			max_size 16777216
		}
		request_body @table_inspect {
			max_size 6356992
		}
		request_body @standard {
			max_size 16000
		}
		reverse_proxy 127.0.0.1:8774 {
			header_up Host 127.0.0.1:8774
			header_up Origin http://127.0.0.1:8774
			header_down Set-Cookie "^root_session=.*$" "$0; Secure"
			header_down Connection-Allowlist "http://127[.]0[.]0[.]1:8774/" "https://workbench.example.invalid/"
			transport http {
				dial_timeout 3s
				response_header_timeout 135s
			}
		}
	}
}

site.example.invalid {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			disable_http_challenge
		}
	}
	@wrong_host not vars {http.request.hostport} site.example.invalid
	respond @wrong_host 421
	reverse_proxy [::1]:8788 {
		header_up Host [::1]:8788
		header_up -Cookie
		header_up -Authorization
	}
}
